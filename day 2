import java.util.Scanner;

public class swt {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("Enter angle in degrees:");
        double angle = sc.nextDouble();

        System.out.println("1. sin");
        System.out.println("2. cos");
        System.out.println("3. tan");
        System.out.println("4. cosec");
        System.out.println("5. sec");
        System.out.println("6. cot");

        System.out.println("Enter your choice:");
        int choice = sc.nextInt();

        double rad = Math.toRadians(angle);

        switch (choice) {

            case 1:
                System.out.println("sin = " + Math.sin(rad));
                break;

            case 2:
                System.out.println("cos = " + Math.cos(rad));
                break;

            case 3:
                System.out.println("tan = " + Math.tan(rad));
                break;

            case 4:
                if (Math.sin(rad) != 0)
                    System.out.println("cosec = " + 1 / Math.sin(rad));
                else
                    System.out.println("Undefined");
                break;

            case 5:
                if (Math.cos(rad) != 0)
                    System.out.println("sec = " + 1 / Math.cos(rad));
                else
                    System.out.println("Undefined");
                break;

            case 6:
                if (Math.tan(rad) != 0)
                    System.out.println("cot = " + 1 / Math.tan(rad));
                else
                    System.out.println("Undefined");
                break;

            default:
                System.out.println("Invalid choice");
        }

        sc.close();
    }
}


